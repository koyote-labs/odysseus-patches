# Keep the foreground gate from cancelling a manual Run now
#
# Fixes: pressing Run now on a scheduled task aborts the run it just started.
# Why: the Run now request itself counts as foreground activity, so the
# foreground gate cancels background runs, including this one. Manual runs are
# now tracked separately and skipped by the gate. An explicit Stop still ends
# them.
# Upstream: not fixed on main or dev at 3b6c1691.
# Test: tests/test_task_scheduler_cancel.py::test_foreground_gate_does_not_cancel_manual_run_now

diff --git a/src/task_scheduler.py b/src/task_scheduler.py
index f2f59d65..be0c1ca6 100644
--- a/src/task_scheduler.py
+++ b/src/task_scheduler.py
@@ -362,6 +362,11 @@ class TaskScheduler:
         self._run_semaphore = asyncio.Semaphore(1)
         self._concurrency_cap = 1
         self._task_handles = {}
+        # Task IDs started by the user via "Run now". These are foreground
+        # work: the foreground gate must not hold or cancel them (the Run
+        # request itself counts as foreground activity and would otherwise
+        # abort the run it just started).
+        self._manual_runs = set()
 
     def _set_run_progress(self, run_id: str, message: str):
         """Persist short live progress text for Activity while a run is active."""
@@ -734,7 +739,7 @@ class TaskScheduler:
         finally:
             db.close()
 
-    async def _execute_task(self, task_id: str, *, bypass_model_slot: bool = False, release_executing: bool = True):
+    async def _execute_task(self, task_id: str, *, bypass_model_slot: bool = False, release_executing: bool = True, manual: bool = False):
         # Create the run record with status="queued" BEFORE waiting on the
         # semaphore so the UI can show that a manually-triggered task is in
         # line behind another. Once we acquire the slot, flip to "running"
@@ -760,13 +765,15 @@ class TaskScheduler:
         finally:
             _q_db.close()
 
+        if manual:
+            self._manual_runs.add(task_id)
         try:
             if bypass_model_slot or not self._task_needs_model_slot(task_id):
                 await self._execute_task_locked(
                     task_id,
                     run_id,
                     release_executing=release_executing,
-                    gate_foreground=not bypass_model_slot,
+                    gate_foreground=not bypass_model_slot and not manual,
                 )
                 return
 
@@ -775,7 +782,7 @@ class TaskScheduler:
                     task_id,
                     run_id,
                     release_executing=release_executing,
-                    gate_foreground=True,
+                    gate_foreground=not manual,
                 )
         except asyncio.CancelledError:
             # If cancellation happens while queued behind the semaphore,
@@ -784,6 +791,8 @@ class TaskScheduler:
             self._defer_immediately_due_task(task_id, delay=timedelta(minutes=15))
             raise
         finally:
+            if manual:
+                self._manual_runs.discard(task_id)
             handle = self._task_handles.get(task_id)
             if handle is current:
                 self._task_handles.pop(task_id, None)
@@ -2270,7 +2279,8 @@ class TaskScheduler:
             if task_id in self._executing:
                 return False
             self._executing.add(task_id)
-        asyncio.create_task(self._execute_task(task_id))
+            self._manual_runs.add(task_id)
+        asyncio.create_task(self._execute_task(task_id, manual=True))
         return True
 
     async def stop_task(self, task_id: str) -> bool:
@@ -2297,7 +2307,8 @@ class TaskScheduler:
         deferred by their cancellation path instead of stealing the app.
         """
         async with self._executing_lock:
-            task_ids = list(self._executing)
+            manual = getattr(self, "_manual_runs", set())
+            task_ids = [t for t in self._executing if t not in manual]
         stopped = 0
         for task_id in task_ids:
             handle = self._task_handles.get(task_id)
diff --git a/tests/test_task_scheduler_cancel.py b/tests/test_task_scheduler_cancel.py
index 3d399f14..3fb4d1df 100644
--- a/tests/test_task_scheduler_cancel.py
+++ b/tests/test_task_scheduler_cancel.py
@@ -103,3 +103,67 @@ def test_stop_task_cleans_up_queued_handle_and_run(tmp_path, monkeypatch):
         assert run.finished_at >= run.started_at
     finally:
         db.close()
+
+
+def test_foreground_gate_does_not_cancel_manual_run_now(tmp_path, monkeypatch):
+    """"Run now" is itself a foreground request. The foreground gate must not
+    abort the run it just started, but an explicit Stop still must."""
+    session_local, ScheduledTask, TaskRun = _setup_db(tmp_path, monkeypatch)
+
+    db = session_local()
+    db.add(ScheduledTask(id="manual-task", owner="alice", name="Manual", task_type="llm", status="active"))
+    db.add(ScheduledTask(id="sched-task", owner="alice", name="Sched", task_type="llm", status="active"))
+    db.commit()
+    db.close()
+
+    from src.task_scheduler import TaskScheduler
+
+    def _run_status(task_id):
+        db2 = session_local()
+        try:
+            run = db2.query(TaskRun).filter(TaskRun.task_id == task_id).first()
+            return run.status if run else None
+        finally:
+            db2.close()
+
+    async def drive():
+        scheduler = TaskScheduler.__new__(TaskScheduler)
+        scheduler._executing = set()
+        scheduler._executing_lock = asyncio.Lock()
+        scheduler._run_semaphore = asyncio.Semaphore(1)
+        scheduler._task_handles = {}
+        scheduler._manual_runs = set()
+        scheduler._concurrency_cap = 1
+        scheduler._task_defer_counts = {}
+        await scheduler._run_semaphore.acquire()  # hold the slot so both runs stay queued
+        try:
+            assert await scheduler.run_task_now("manual-task") is True
+            async with scheduler._executing_lock:
+                scheduler._executing.add("sched-task")
+            sched = asyncio.create_task(scheduler._execute_task("sched-task"))
+            for _ in range(50):
+                if _run_status("manual-task") == "queued" and _run_status("sched-task") == "queued":
+                    break
+                await asyncio.sleep(0.01)
+
+            await scheduler.stop_background_tasks_for_foreground(reason="foreground request POST /api/tasks/manual-task/run")
+            try:
+                await sched
+            except asyncio.CancelledError:
+                pass
+
+            assert _run_status("sched-task") == "aborted"
+            assert _run_status("manual-task") == "queued"
+            assert "manual-task" in scheduler._executing
+
+            assert await scheduler.stop_task("manual-task") is True
+            for _ in range(50):
+                if "manual-task" not in scheduler._manual_runs:
+                    break
+                await asyncio.sleep(0.01)
+            assert _run_status("manual-task") == "aborted"
+            assert "manual-task" not in scheduler._manual_runs
+        finally:
+            scheduler._run_semaphore.release()
+
+    asyncio.run(drive())
