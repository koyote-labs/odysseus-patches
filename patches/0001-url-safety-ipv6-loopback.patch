# Allow IPv6 loopback when private address blocking is off
#
# Fixes: src/url_safety.py rejects http://localhost on hosts that resolve it
# to ::1, such as macOS, even with private address blocking off.
# Why: CPython reports ::1 as is_reserved because it sits inside ::/8, and the
# reserved check ran before the loopback check. Judging loopback first keeps
# the strict mode behaviour and lets local model endpoints work.
# Upstream: not fixed on main or dev at 3b6c1691. Being prepared as an
# upstream pull request.
# Test: tests/test_url_safety.py::test_ipv6_loopback_allowed_by_default

diff --git a/src/url_safety.py b/src/url_safety.py
index c8bf8632..b9eb5168 100644
--- a/src/url_safety.py
+++ b/src/url_safety.py
@@ -46,6 +46,11 @@ def _classify(ip: ipaddress._BaseAddress, *, block_private: bool) -> Optional[st
         ip = ip.ipv4_mapped
     if ip.is_link_local:
         return f"link-local address blocked (SSRF metadata risk): {ip}"
+    # Judge loopback before `is_reserved`: CPython reports IPv6 ``::1`` as
+    # reserved (it sits inside ``::/8``), which would reject ``localhost`` on
+    # hosts that resolve it to ::1 (macOS) even with private blocking off.
+    if ip.is_loopback:
+        return f"private/shared/loopback address blocked: {ip}" if block_private else None
     if ip.is_multicast or ip.is_reserved or ip.is_unspecified:
         return f"disallowed address: {ip}"
     if block_private and (
diff --git a/tests/test_url_safety.py b/tests/test_url_safety.py
index d82d3887..97073eea 100644
--- a/tests/test_url_safety.py
+++ b/tests/test_url_safety.py
@@ -57,6 +57,16 @@ def test_loopback_and_lan_allowed_by_default_local_first():
     assert check_outbound_url("http://nas.local:1234/v1", resolver=LAN)[0] is True
 
 
+def test_ipv6_loopback_allowed_by_default():
+    # macOS resolves localhost to both 127.0.0.1 and ::1. CPython reports ::1
+    # as is_reserved, which must not reject it before loopback is considered.
+    dual = _resolver({"localhost": ["127.0.0.1", "::1"]})
+    ok, reason = check_outbound_url("http://localhost:8200/v1", resolver=dual)
+    assert ok is True, reason
+    ok, reason = check_outbound_url("http://localhost:8200/v1", block_private=True, resolver=dual)
+    assert ok is False and "loopback" in reason
+
+
 def test_strict_mode_blocks_private_and_loopback():
     ok, reason = check_outbound_url("http://localhost:8080", block_private=True, resolver=LOOPBACK)
     assert ok is False and "private" in reason
