--- /dev/null
+++ b/tests/test_home_base_groups.py
@@ -0,0 +1,57 @@
+"""The signed-in person's groups travel with the identity, and only there."""
+
+import os
+
+import pytest
+
+from src import home_base_identity as hb
+
+PERMISSION_URL = "http://permission-layer:8000/v1/chat/completions"
+
+
+@pytest.fixture(autouse=True)
+def configured(monkeypatch):
+    monkeypatch.setenv("HOME_BASE_PERMISSION_LAYER_HOST", "permission-layer")
+    monkeypatch.setenv("HOME_BASE_CALLER_SECRET", "synthetic-caller-secret")
+
+
+def test_groups_are_sent_to_the_permission_layer():
+    user = hb.set_user("alex")
+    groups = hb.set_groups({"home-base-adults", "home-base-admins"})
+    try:
+        out = hb.with_identity(PERMISSION_URL, {})
+    finally:
+        hb.reset_user(user)
+        hb.reset_groups(groups)
+    assert out["X-Home-Base-Groups"] == "home-base-admins|home-base-adults"
+    assert out["X-Home-Base-User"] == "alex"
+
+
+def test_no_groups_header_when_the_person_has_none():
+    user = hb.set_user("alex")
+    try:
+        assert "X-Home-Base-Groups" not in hb.with_identity(PERMISSION_URL, {})
+    finally:
+        hb.reset_user(user)
+
+
+def test_groups_never_go_anywhere_else():
+    user = hb.set_user("alex")
+    groups = hb.set_groups({"home-base-adults"})
+    try:
+        out = hb.with_identity("https://api.openai.com/v1/chat/completions", {"A": "1"})
+    finally:
+        hb.reset_user(user)
+        hb.reset_groups(groups)
+    assert out == {"A": "1"}
+
+
+def test_groups_do_not_leak_between_requests():
+    token = hb.set_groups({"home-base-kids"})
+    hb.reset_groups(token)
+    assert hb.current_groups() == frozenset()
+
+
+def test_edge_groups_parses_the_pipe_list():
+    assert hb.edge_groups({"X-Home-Base-Groups": "a | b|| c "}) == {"a", "b", "c"}
+    assert hb.edge_groups({}) == set()
